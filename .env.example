DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters

# Google account sign-in. The same OAuth web client may also be used for Calendar.
GOOGLE_OAUTH_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=replace_with_google_oauth_client_secret

# Stripe Billing — begin with sandbox/test values.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX=false

# Aerial imagery. Keys stay server-side behind the tile proxy.
# Google Map Tiles is primary; Mapbox and Nearmap are retained only as fallbacks.
GOOGLE_MAPS_API_KEY=replace_with_google_map_tiles_api_key
MAPBOX_ACCESS_TOKEN=pk.replace_with_mapbox_public_access_token
NEARMAP_API_KEY=replace_with_nearmap_api_key

# OpenAI vision model used to count visible markings inside the selected lot.
OPENAI_API_KEY=sk-proj-replace_me

# CRM and operations integrations. Add credentials only for products you use.
# Encrypts per-account OAuth tokens stored in D1. Use a unique random value (32+ chars).
INTEGRATION_TOKEN_KEY=replace_with_at_least_32_random_characters
# Register these exact production callback paths with each vendor app:
# https://YOUR_DOMAIN/api/integrations/hubspot/callback
# https://YOUR_DOMAIN/api/integrations/jobber/callback
# https://YOUR_DOMAIN/api/integrations/quickbooks/callback
# https://YOUR_DOMAIN/api/integrations/stripe/callback

# HubSpot OAuth is for customer-connected accounts. A private app token remains a
# supported single-account fallback for the founder's own portal.
HUBSPOT_CLIENT_ID=replace_with_hubspot_app_client_id
HUBSPOT_CLIENT_SECRET=replace_with_hubspot_app_client_secret
HUBSPOT_PRIVATE_APP_TOKEN=replace_with_hubspot_private_app_token
HUBSPOT_DEAL_STAGE_ID=appointmentscheduled

JOBBER_CLIENT_ID=replace_with_jobber_client_id
JOBBER_CLIENT_SECRET=replace_with_jobber_client_secret
QUICKBOOKS_CLIENT_ID=replace_with_intuit_client_id
QUICKBOOKS_CLIENT_SECRET=replace_with_intuit_client_secret

# Stripe Connect is separate from Stripe Billing above. Create a Connect platform
# and copy its ca_ client ID here.
STRIPE_CONNECT_CLIENT_ID=ca_replace_with_connect_client_id

# OneCrew currently exposes Lead Intake via an account-generated API key.
ONECREW_API_KEY=oc1_replace_with_onecrew_api_key
ONECREW_LEAD_INTAKE_URL=https://app.getonecrew.com/api/v0/lead-intake

OPEN_METEO_API_KEY=replace_with_open_meteo_commercial_api_key

# Google Calendar OAuth for Scale job scheduling. Add the callback URL shown below
# to the Google Cloud OAuth client's authorized redirect URIs.
GOOGLE_CALENDAR_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_CALENDAR_TOKEN_KEY=replace_with_at_least_32_random_characters
STRIPEPROS_OUTBOUND_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/replace/me
STRIPEPROS_OUTBOUND_WEBHOOK_SECRET=replace_with_webhook_secret

# Founder HQ — access is denied unless the signed-in account matches this address.
FOUNDER_EMAIL=founder@example.com
GITHUB_REPOSITORY=patdudley/StripePros
# Optional for higher GitHub API limits on private repositories.
GITHUB_TOKEN=github_pat_replace_me
